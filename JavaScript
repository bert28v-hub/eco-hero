function stopsReached(route){let ok=true;return route.map(s=>{const r=ok;if(s.kind==='m'&&!done[s.id])ok=false;return r})}
// ===== Map (no library): satellite tiles, drag, wheel/pinch zoom, waypoints =====
const Z_MIN=7,Z_MAX=16,BOUNDS={s:41.6,w:26.4,n:44,e:29.6};
const TILES='https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/';
const map={el:null,w:0,h:0,lat:42.85,lng:27.95,zoom:8,tiles:new Map(),markers:[],pts:[],last:0,popup:null,raf:0,anim:0,moved:false,sx:0,sy:0};
const clampN=(v,a,b)=>Math.max(a,Math.min(b,v));
 
// Web-Mercator maths
const proj=(lat,lng,z)=>{const s=256*2**z,r=lat*Math.PI/180;return{x:(lng+180)/360*s,y:(1-Math.log(Math.tan(r)+1/Math.cos(r))/Math.PI)/2*s}};
const unproj=(x,y,z)=>{const s=256*2**z;return{lat:Math.atan(Math.sinh(Math.PI*(1-2*y/s)))*180/Math.PI,lng:x/s*360-180}};
function toScreen(lat,lng){const p=proj(lat,lng,map.zoom),c=proj(map.lat,map.lng,map.zoom);return{x:p.x-c.x+map.w/2,y:p.y-c.y+map.h/2}}
function toLatLng(x,y){const c=proj(map.lat,map.lng,map.zoom);return unproj(c.x+x-map.w/2,c.y+y-map.h/2,map.zoom)}
function clampView(){map.zoom=clampN(map.zoom,Z_MIN,Z_MAX);map.lat=clampN(map.lat,BOUNDS.s,BOUNDS.n);map.lng=clampN(map.lng,BOUNDS.w,BOUNDS.e)}
 
function requestRender(){if(!map.raf)map.raf=requestAnimationFrame(()=>{map.raf=0;renderMap()})}
function panBy(dx,dy){const c=proj(map.lat,map.lng,map.zoom),n=unproj(c.x-dx,c.y-dy,map.zoom);map.lat=n.lat;map.lng=n.lng;clampView();requestRender()}
function zoomAt(z,x,y){
  z=clampN(z,Z_MIN,Z_MAX);const ll=toLatLng(x,y);map.zoom=z;
  const p=proj(ll.lat,ll.lng,z),c=unproj(p.x-(x-map.w/2),p.y-(y-map.h/2),z);
  map.lat=c.lat;map.lng=c.lng;clampView();requestRender();
}
function animateTo(lat,lng,zoom,ms=500){
  const id=++map.anim,a={lat:map.lat,lng:map.lng,zoom:map.zoom},t0=performance.now();
  (function step(t){
    if(id!==map.anim)return;
    const p=1-Math.pow(1-Math.min(1,(t-t0)/ms),3);
    map.lat=a.lat+(lat-a.lat)*p;map.lng=a.lng+(lng-a.lng)*p;map.zoom=a.zoom+(zoom-a.zoom)*p;
    renderMap();if(p<1)requestAnimationFrame(step);
  })(t0);
}
function routeView(){
  const pts=ROUTES[currentMode],pad=70,w=map.w||600,h=map.h||500;let z=10,xs,ys;
  for(;;z-=.5){
    const ps=pts.map(s=>proj(s.lat,s.lng,z));xs=ps.map(p=>p.x);ys=ps.map(p=>p.y);
    if(z<=Z_MIN||(Math.max(...xs)-Math.min(...xs)<=w-2*pad&&Math.max(...ys)-Math.min(...ys)<=h-2*pad))break;
  }
  const c=unproj((Math.min(...xs)+Math.max(...xs))/2,(Math.min(...ys)+Math.max(...ys))/2,z);
  return{lat:c.lat,lng:c.lng,zoom:z};
}
function fitRoute(animate=true){
  const v=routeView();
  if(animate)animateTo(v.lat,v.lng,v.zoom,600);
  else{map.lat=v.lat;map.lng=v.lng;map.zoom=v.zoom;clampView();renderMap()}
}
 
function renderMap(){
  if(!map.el)return;
  map.w=map.el.clientWidth;map.h=map.el.clientHeight;if(!map.w)return;
  const tz=clampN(Math.round(map.zoom),Z_MIN,Z_MAX),ts=256*2**(map.zoom-tz),n=2**tz,c=proj(map.lat,map.lng,map.zoom);
  const ox=c.x-map.w/2,oy=c.y-map.h/2,seen=new Set();
  const x0=Math.max(0,Math.floor(ox/ts)),x1=Math.min(n-1,Math.floor((ox+map.w)/ts));
  const y0=Math.max(0,Math.floor(oy/ts)),y1=Math.min(n-1,Math.floor((oy+map.h)/ts));
  for(let ty=y0;ty<=y1;ty++)for(let tx=x0;tx<=x1;tx++){
    const key=tz+'/'+tx+'/'+ty;seen.add(key);
    let img=map.tiles.get(key);
    if(!img){img=new Image();img.draggable=false;img.src=TILES+tz+'/'+ty+'/'+tx;map.tileEl.appendChild(img);map.tiles.set(key,img)}
    img.style.setProperty('--x',(tx*ts-ox)+'px');img.style.setProperty('--y',(ty*ts-oy)+'px');img.style.setProperty('--s',(ts+1)+'px');
  }
  for(const[k,img]of map.tiles)if(!seen.has(k)){img.remove();map.tiles.delete(k)}
 
  const P=map.pts.map(p=>{const s=toScreen(p.lat,p.lng);return s.x.toFixed(1)+','+s.y.toFixed(1)});
  map.lineBase.setAttribute('points',P.join(' '));
  map.lineDone.setAttribute('points',map.last>0?P.slice(0,map.last+1).join(' '):'');
  map.markers.forEach(m=>{const s=toScreen(m.lat,m.lng);m.el.style.setProperty('--x',s.x+'px');m.el.style.setProperty('--y',s.y+'px')});
  if(map.popup){const s=toScreen(map.popup.lat,map.popup.lng);map.popupEl.style.setProperty('--x',s.x+'px');map.popupEl.style.setProperty('--y',s.y+'px')}
  map.el.classList.toggle('show-wp',map.zoom>=9.5);
}
 
function rebuildMap(){
  if(!map.el)return;
  const route=ROUTES[currentMode],reached=stopsReached(route);let n=0;
  map.layer.innerHTML='';map.markers=[];map.pts=route;map.last=reached.lastIndexOf(true);closePopup();
  route.forEach((s,i)=>{
    const el=document.createElement('div');el.className='marker';
    if(s.kind==='m'){
      el.classList.add('mission');
      el.innerHTML=`<div class="map-node ${s.color}">${done[s.id]?'<div class="done-badge">✔</div>':''}<div class="map-label">${i18n[currentLang][s.key]}</div></div>`;
      el.addEventListener('click',()=>{if(!map.moved)startMiniGame(s.id)});
    }else{
      n++;el.classList.add('waypoint');
      el.innerHTML=`<div class="wp-node ${reached[i]?'reached':''}">${reached[i]?'⚑':n}<div class="wp-label">${s.n[currentLang]}</div></div>`;
      el.addEventListener('click',()=>{if(map.moved)return;sfx.pop();openPopup(s,reached[i])});
    }
    map.layer.appendChild(el);map.markers.push({el,lat:s.lat,lng:s.lng});
  });
  requestRender();
}
function openPopup(s,unlocked){
  map.popup={lat:s.lat,lng:s.lng};
  map.popupEl.innerHTML=unlocked?`<b>${s.n[currentLang]}</b><br>${s.f[currentLang]}`:i18n[currentLang].wpLocked;
  map.popupEl.classList.remove('hidden');requestRender();
}
