function initMap(){
  if(map.el)return;
  const el=map.el=document.getElementById('map-container');
  map.tileEl=el.querySelector('.map-tiles');map.layer=el.querySelector('.map-markers');map.popupEl=el.querySelector('.map-popup');
  [map.lineBase,map.lineDone]=el.querySelectorAll('polyline');
 
  el.querySelector('.map-controls').addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b)return;sfx.pop();const d=+b.dataset.z;
    if(d)animateTo(map.lat,map.lng,clampN(Math.round(map.zoom)+d,Z_MIN,Z_MAX));else fitRoute();
  });
 
  const ptrs=new Map();let prevD=0;
  const rel=e=>{const r=el.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}};
  el.addEventListener('pointerdown',e=>{
    if(e.target.closest('.map-controls'))return;
    map.anim++;ptrs.set(e.pointerId,rel(e));map.moved=false;map.sx=e.clientX;map.sy=e.clientY;prevD=0;el.classList.add('dragging');
  });
  window.addEventListener('pointermove',e=>{
    const p=ptrs.get(e.pointerId);if(!p)return;const n=rel(e);
    if(Math.hypot(e.clientX-map.sx,e.clientY-map.sy)>6)map.moved=true;
    if(ptrs.size===1&&map.moved)panBy(n.x-p.x,n.y-p.y);
    ptrs.set(e.pointerId,n);
    if(ptrs.size===2){
      const[a,b]=[...ptrs.values()],d=Math.hypot(a.x-b.x,a.y-b.y);
      if(prevD)zoomAt(map.zoom+Math.log2(d/prevD),(a.x+b.x)/2,(a.y+b.y)/2);
      prevD=d;map.moved=true;
    }
  });
  const up=e=>{ptrs.delete(e.pointerId);prevD=0;if(!ptrs.size)el.classList.remove('dragging')};
  window.addEventListener('pointerup',up);window.addEventListener('pointercancel',up);
  el.addEventListener('wheel',e=>{e.preventDefault();map.anim++;const r=rel(e);zoomAt(map.zoom+clampN(-e.deltaY*.0025,-.5,.5),r.x,r.y)},{passive:false});
  el.addEventListener('dblclick',e=>{if(e.target.closest('.marker,.map-controls,.map-popup'))return;const r=rel(e);map.anim++;zoomAt(map.zoom+1,r.x,r.y)});
  el.addEventListener('click',e=>{if(!map.moved&&!e.target.closest('.marker,.map-popup,.map-controls'))closePopup()});
  window.addEventListener('resize',requestRender);
 
  map.w=el.clientWidth;map.h=el.clientHeight;
  rebuildMap();fitRoute(false);
  setTimeout(()=>{renderMap();fitRoute(false)},80);
}
