const input={x:CW/2,y:CH/2,down:false,click:false,swipeSpeed:0},trailPoints=[],keys={};
 
function updateInput(e){
  const r=canvas.getBoundingClientRect(),p=e.touches?e.touches[0]:e;
  if(!p)return;
  const nx=(p.clientX-r.left)*(CW/r.width),ny=(p.clientY-r.top)*(CH/r.height);
  input.swipeSpeed=Math.hypot(nx-input.x,ny-input.y);input.x=nx;input.y=ny;
  if(input.down){trailPoints.push({x:nx,y:ny});if(trailPoints.length>15)trailPoints.shift()}
}
window.addEventListener('mousemove',updateInput);
window.addEventListener('touchmove',e=>{if(e.target===canvas){e.preventDefault();updateInput(e)}},{passive:false});
const press=e=>{if(e.target===canvas){input.down=true;input.click=true;updateInput(e);trailPoints.length=0}};
window.addEventListener('mousedown',press);window.addEventListener('touchstart',press);
const release=()=>{input.down=false;trailPoints.length=0};
window.addEventListener('mouseup',release);window.addEventListener('touchend',release);
window.addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true});
window.addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false});
 
