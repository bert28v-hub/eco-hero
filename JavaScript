function initRecycle(){
  startTimer(60);let items=[],dragged=null,sorted=0;const target=7;
  const bins=[{x:CW/2-250,color:'#3b82f6',type:'paper',bg:'Хартия',en:'Paper'},{x:CW/2-70,color:'#eab308',type:'plastic',bg:'Пластмаса',en:'Plastic'},{x:CW/2+110,color:'#22c55e',type:'glass',bg:'Стъкло',en:'Glass'}].map(b=>({...b,y:CH-130,w:140,h:110}));
  (function loop(){
    if(!gameActive)return;
    const g=ctx.createLinearGradient(0,0,0,CH);g.addColorStop(0,'#2e1065');g.addColorStop(1,'#4c1d95');ctx.fillStyle=g;ctx.fillRect(0,0,CW,CH);
    ctx.fillStyle='#1e293b';ctx.fillRect(0,160,CW,80);ctx.fillStyle='#334155';
    for(let i=0;i<CW+100;i+=60)ctx.fillRect(i-(time*40)%60,160,30,80);
    if(items.length<3&&Math.random()<.02)items.push({x:-40,y:200,type:['paper','plastic','glass'][Math.floor(Math.random()*3)],vx:1.5,rot:Math.random(),dragging:false});
    bins.forEach(b=>{const bump=dragged&&Math.abs(input.x-(b.x+b.w/2))<90?-12:0;ctx.fillStyle=b.color;ctx.beginPath();ctx.roundRect(b.x,b.y+bump,b.w,b.h,14);ctx.fill();ctx.fillStyle='rgba(0,0,0,.3)';ctx.fillRect(b.x,b.y+bump,b.w,22);ctx.fillStyle='#fff';ctx.font='bold 20px Nunito';ctx.textAlign='center';ctx.fillText(b[currentLang],b.x+b.w/2,b.y+65+bump)});
    for(let i=items.length-1;i>=0;i--){
      const it=items[i];
      if(it.dragging){it.x+=(input.x-it.x)*.35;it.y+=(input.y-it.y)*.35}
      else{it.x+=it.vx;it.rot+=.01;if(it.y>200)it.y-=(it.y-200)*.1}
      if(input.click&&!dragged&&Math.hypot(input.x-it.x,input.y-it.y)<60){it.dragging=true;dragged=it;sfx.pop()}
      if(!input.down&&it.dragging){
        it.dragging=false;dragged=null;
        const bin=bins.find(b=>it.x>=b.x-20&&it.x<=b.x+b.w+20&&it.y>=b.y-40&&it.y<=b.y+b.h+30);
        if(bin){
          if(bin.type===it.type){combo++;sorted++;addScore(15*combo,it.x,it.y);sfx.coin();spawnParticles(it.x,it.y,bin.color,25);items.splice(i,1);if(sorted>=target)return endGame(true);continue}
          combo=0;addScore(-5,it.x,it.y);sfx.buzz();spawnParticles(it.x,it.y,'#ef4444',12);
        }
      }
      drawTrashItem(ctx,it.x,it.y,it.type,it.rot);
      if(it.x>CW+60)items.splice(i,1);
    }
    updateVFX(ctx);input.click=false;animationId=requestAnimationFrame(loop);
  })();
}
 
function initPark(){
  startTimer(45);const trees=[],smogs=[],clouds=[],targetTrees=8;
  for(let i=0;i<4;i++){clouds.push({x:Math.random()*CW,y:Math.random()*150+40,s:Math.random()*.5+.5,v:Math.random()*.4+.2});smogs.push({x:100+Math.random()*(CW-200),y:100+Math.random()*220,r:45,vx:(Math.random()-.5)*1.2})}
  (function loop(){
    if(!gameActive)return;
    let g=ctx.createLinearGradient(0,0,0,CH);g.addColorStop(0,'#38bdf8');g.addColorStop(1,'#bae6fd');ctx.fillStyle=g;ctx.fillRect(0,0,CW,CH);
    clouds.forEach(c=>{c.x+=c.v;if(c.x>CW+100){c.x=-100;c.y=Math.random()*150+40}drawCloud(ctx,c.x,c.y,c.s)});
    const so=-(time*8)%250;for(let i=-250;i<CW;i+=250)drawSkyline(ctx,i+so);
    g=ctx.createLinearGradient(0,CH-180,0,CH);g.addColorStop(0,'#4ade80');g.addColorStop(1,'#15803d');ctx.fillStyle=g;ctx.beginPath();ctx.ellipse(CW/2,CH,CW*.8,220,0,Math.PI,0);ctx.fill();
    if(smogs.length<3&&Math.random()<.02)smogs.push({x:Math.random()*CW,y:100+Math.random()*220,r:45,vx:(Math.random()-.5)*1.5});
    if(input.click){
      let hit=false;
      for(let i=smogs.length-1;i>=0;i--){const s=smogs[i];if(Math.hypot(input.x-s.x,input.y-s.y)<s.r+15){spawnParticles(s.x,s.y,'#64748b',20);smogs.splice(i,1);hit=true;combo++;addScore(10*combo,s.x,s.y);sfx.swish();break}}
      if(!hit&&input.y>CH-220){trees.push({x:input.x,y:input.y,scale:.1});sfx.pop();spawnParticles(input.x,input.y,'#22c55e',15);addScore(15,input.x,input.y);if(trees.length>=targetTrees)return endGame(true)}
    }
