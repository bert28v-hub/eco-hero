    ctx.fillStyle='rgba(71,85,105,.85)';ctx.shadowColor='#475569';ctx.shadowBlur=15;
    for(let i=smogs.length-1;i>=0;i--){const s=smogs[i];s.x+=s.vx;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,6.28);ctx.arc(s.x-s.r*.5,s.y+s.r*.3,s.r*.6,0,6.28);ctx.arc(s.x+s.r*.5,s.y+s.r*.3,s.r*.6,0,6.28);ctx.fill();if(s.x<-80||s.x>CW+80)smogs.splice(i,1)}
    ctx.shadowBlur=0;updateVFX(ctx);input.click=false;animationId=requestAnimationFrame(loop);
  })();
}
 
function initVacuum(){
  startTimer(50);const sub={x:150,y:CH/2,vx:0,vy:0,rot:0},items=[],bubbles=[],target=10;let collected=0;
  (function loop(){
    if(!gameActive)return;
    const g=ctx.createLinearGradient(0,0,0,CH);g.addColorStop(0,'#0284c7');g.addColorStop(1,'#1e1b4b');ctx.fillStyle=g;ctx.fillRect(0,0,CW,CH);
    if(Math.random()<.1)bubbles.push({x:Math.random()*CW,y:CH+20,s:Math.random()*8+4,vy:-1-Math.random()*1.5});
    ctx.fillStyle='rgba(255,255,255,.3)';
    for(let i=bubbles.length-1;i>=0;i--){const b=bubbles[i];b.y+=b.vy;b.x+=Math.sin(time+b.y/50)*1.5;ctx.beginPath();ctx.arc(b.x,b.y,b.s,0,6.28);ctx.fill();if(b.y<-20)bubbles.splice(i,1)}
    const a=.9;
    if(keys.arrowup||keys.w)sub.vy-=a;if(keys.arrowdown||keys.s)sub.vy+=a;if(keys.arrowleft||keys.a)sub.vx-=a;if(keys.arrowright||keys.d)sub.vx+=a;
    if(input.down){sub.vx+=(input.x-sub.x)*.03;sub.vy+=(input.y-sub.y)*.03}
    sub.vx*=.92;sub.vy*=.92;sub.x=Math.max(50,Math.min(CW-50,sub.x+sub.vx));sub.y=Math.max(50,Math.min(CH-50,sub.y+sub.vy));sub.rot=sub.vx*.04;
    if(items.length<5&&Math.random()<.035){const j=Math.random()>.75;items.push({x:CW+50,y:Math.random()*(CH-120)+60,type:j?'jelly':'trash',icon:['paper','plastic','glass'][Math.floor(Math.random()*3)],vx:j?-1.2:-1.8})}
    for(let i=items.length-1;i>=0;i--){
      const it=items[i];it.x+=it.vx;
      if(it.type==='trash'&&it.x>sub.x&&it.x<sub.x+240&&Math.abs(it.y-sub.y)<120){it.x-=5;it.y+=(sub.y-it.y)*.15}
      if(it.type==='jelly')drawJellyfish(ctx,it.x,it.y);else drawTrashItem(ctx,it.x,it.y,it.icon,time);
      if(Math.hypot(it.x-sub.x,it.y-sub.y)<50){
        items.splice(i,1);
        if(it.type==='jelly'){sfx.buzz();addScore(-5,sub.x,sub.y);spawnParticles(sub.x,sub.y,'#ec4899',15);continue}
        collected++;combo++;addScore(15*combo,sub.x,sub.y);sfx.bubble();sfx.coin();spawnParticles(sub.x,sub.y,'#38bdf8',20);
        if(collected>=target)return endGame(true);continue;
      }
      if(it.x<-50)items.splice(i,1);
    }
    ctx.fillStyle='rgba(56,189,248,.18)';ctx.beginPath();ctx.moveTo(sub.x+30,sub.y);ctx.lineTo(sub.x+240,sub.y-90);ctx.lineTo(sub.x+240,sub.y+90);ctx.fill();
    drawSubmarine(ctx,sub.x,sub.y,sub.rot);updateVFX(ctx);animationId=requestAnimationFrame(loop);
  })();
}
 
