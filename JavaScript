let screenShake=0,particles=[],confetti=[],time=0;
function spawnParticles(x,y,color,n,sp=8){for(let i=0;i<n;i++)particles.push({x,y,vx:(Math.random()-.5)*sp,vy:(Math.random()-.5)*sp,life:1,color,size:Math.random()*8+4})}
function triggerConfetti(){const c=['#fde047','#38bdf8','#4ade80','#fb923c','#a855f7'];for(let i=0;i<100;i++)confetti.push({x:Math.random()*CW,y:-20-Math.random()*200,vx:(Math.random()-.5)*4,vy:Math.random()*3+2,rot:Math.random()*6.28,rs:(Math.random()-.5)*.2,color:c[i%5],w:Math.random()*10+5,h:Math.random()*10+10})}
function updateVFX(ctx){
  time+=.05;
  if(screenShake>0){ctx.translate((Math.random()-.5)*screenShake,(Math.random()-.5)*screenShake);screenShake*=.85;if(screenShake<.5)screenShake=0}
  for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vx*=.95;p.vy*=.95;p.life-=.025;if(p.life<=0){particles.splice(i,1);continue}ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,6.28);ctx.fill()}
  ctx.globalAlpha=1;
  for(let i=confetti.length-1;i>=0;i--){const c=confetti[i];c.x+=c.vx;c.y+=c.vy;c.rot+=c.rs;if(c.y>CH){confetti.splice(i,1);continue}ctx.save();ctx.translate(c.x,c.y);ctx.rotate(c.rot);ctx.fillStyle=c.color;ctx.fillRect(-c.w/2,-c.h/2,c.w,c.h);ctx.restore()}
  if(trailPoints.length>1){ctx.beginPath();ctx.moveTo(trailPoints[0].x,trailPoints[0].y);trailPoints.forEach(p=>ctx.lineTo(p.x,p.y));ctx.strokeStyle='#38bdf8';ctx.lineWidth=8;ctx.lineCap=ctx.lineJoin='round';ctx.shadowColor='#0ea5e9';ctx.shadowBlur=15;ctx.stroke();ctx.shadowBlur=0}
}
